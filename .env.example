# Скопируйте в .env:  cp .env.example .env
# Ключи сгенерируйте командой:  docker compose run --rm web flask gen-keys   (или: flask gen-keys)
APP_ENV=development            # production в проде (включает защитные проверки конфигурации)
SECRET_KEY=
ENCRYPTION_KEYS=               # Fernet-ключ(и) через запятую; ПЕРВЫЙ шифрует, остальные для ротации. ПОТЕРЯ = потеря всех BYOK-ключей агентов
INTERNAL_TOKEN=                # токен для /_internal/tls-ask (Caddy)

BASE_DOMAIN=localhost          # прод: example.com
URL_SCHEME=http                # прод: https
PUBLIC_PORT=8000               # прод: пусто
PLATFORM_EXTRA_HOSTS=127.0.0.1
CUSTOM_DOMAIN_TARGET=          # прод: sites.example.com (CNAME-цель для своих доменов агентов)

POSTGRES_PASSWORD=travelpilot  # прод: длинный случайный
ACME_EMAIL=you@example.com     # только прод (Let's Encrypt)

# Регистрация / модерация
REGISTRATION_OPEN=true
REQUIRE_MANUAL_APPROVAL=true

# Почта (без SMTP письма пишутся в лог контейнера)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=TravelPilot <no-reply@example.com>

# Реквизиты оператора платформы (Impressum, DDG §5) — ОБЯЗАТЕЛЬНО заполнить
PLATFORM_NAME=TravelPilot
PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_ADDRESS=
PLATFORM_OPERATOR_EMAIL=
PLATFORM_OPERATOR_VAT=

# Лимиты чата и модели (необязательно)
CHAT_MAX_USER_MESSAGES_PER_SESSION=40
CHAT_DAILY_CAP_PER_AGENCY=300
DEFAULT_CHAT_MODEL=claude-haiku-4-5-20251001
DEFAULT_BLOG_MODEL=claude-sonnet-5-5
WORKER_INTERVAL_SECONDS=300
